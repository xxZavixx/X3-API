# X3 API x402 Backend Environment Variables
# Copy this to .env.local and fill in your values

# ============ STRIPE ============
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_YOUR_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_PUBLISHABLE_KEY_HERE

# Created via:
# curl https://api.stripe.com/v1/crypto/deposit_addresses \
#   -u "sk_live_YOUR_SECRET_KEY:" \
#   -H "Stripe-Version: 2026-05-27.preview" \
#   -d network=base
DEPOSIT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ============ COINBASE DEVELOPER PLATFORM ============
# Sign up at: https://portal.cdp.coinbase.com/
# Create API keys for x402 facilitator
CDP_API_KEY_ID=organizations/.../apiKeys/...
# Use the complete secret from the CDP key creation dialog. It must be either
# a base64 Ed25519 key or an EC private-key PEM. For a one-line Vercel value,
# preserve PEM newlines as literal \n characters.
CDP_API_KEY_SECRET=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----

# ============ SERVER ============
PORT=4242
NODE_ENV=production

# ============ CLAUDE API (Optional - for trade analysis) ============
# If using Anthropic SDK for AI analysis
ANTHROPIC_API_KEY=sk-ant-...
